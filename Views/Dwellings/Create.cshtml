@model John_Baxter_Schilling.Data.Dwelling

@{
    ViewBag.Title = "Add property";
}

<div class="mb-4">
    <p class="text-uppercase text-secondary small fw-semibold mb-1">Portfolio</p>
    <h1 class="h2 mb-1">Add property</h1>
    <p class="text-secondary mb-0">Enter the dwelling details below.</p>
</div>

<div class="card">
    <div class="card-body p-4">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            @Html.Partial("_DwellingFormFields", Model)
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Create property</button>
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>
