@model John_Baxter_Schilling.Data.Dwelling

@{
    ViewBag.Title = "Delete property";
}

<div class="mb-4">
    <p class="text-uppercase text-secondary small fw-semibold mb-1">Portfolio</p>
    <h1 class="h2 mb-1">Delete property</h1>
    <p class="text-secondary mb-0">Review the record before confirming deletion.</p>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger-subtle">
        <h2 class="h5 text-danger-emphasis mb-0">Confirm property deletion</h2>
    </div>
    <div class="card-body p-4">
        <p class="mb-3">You are about to delete <strong>@Model.OfficialAddress</strong>. This action cannot be undone.</p>
        <dl class="row">
            <dt class="col-sm-4">Availability</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Availability)</dd>
            <dt class="col-sm-4">Currently rented</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.CurrentlyRented)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PropertyPurchaseAmount)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PropertyPurchaseAmount)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NamesOnLease)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.NamesOnLease)</dd>
        </dl>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-danger">Delete property</button>
                @Html.ActionLink("Keep property", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>
