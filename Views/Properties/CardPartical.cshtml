@model John_Baxter_Schilling.Data.Dwelling

@{
    var mapsBrowserKey = Environment.GetEnvironmentVariable("GOOGLE_MAPS_BROWSER_API_KEY");
}

<article class="card h-100 property-card">
    <div class="card-body d-flex flex-column">
        <h2 class="h5 card-title property-address">@Model.OfficialAddress</h2>
        <p class="card-text text-secondary">@(Model.CurrentlyRented == true ? "Currently rented" : "Availability to be confirmed")</p>
        @if (!String.IsNullOrWhiteSpace(mapsBrowserKey))
        {
            <img class="property-map-preview mb-3"
                 src="@string.Format("https://maps.googleapis.com/maps/api/streetview?size=600x600&amp;location={0}&amp;key={1}", Uri.EscapeDataString(Model.OfficialAddress), Uri.EscapeDataString(mapsBrowserKey))"
                 alt="Street view preview near @Model.OfficialAddress"
                 loading="lazy" />
        }
        <div class="mt-auto">
            @Html.ActionLink("View details", "Details", "Dwellings", new { id = Model.Id }, new { @class = "btn btn-outline-primary btn-sm" })
        </div>
    </div>
</article>
